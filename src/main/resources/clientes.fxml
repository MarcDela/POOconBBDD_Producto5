<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" alignment="TOP_CENTER" 
      styleClass="root-container" 
      stylesheets="@designs.css" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="InnerJoinConElCafe.controlador.clientesControlador">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>
        <Label text="GESTIÓN DE CLIENTES" styleClass="titulo-main" />
        
        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="Listado de Clientes">
                    <content>
                        <VBox spacing="10">
                            <padding>
                                <Insets top="10" right="10" bottom="10" left="10"/>
                            </padding>
                            <Button text="Actualizar Tabla" onAction="#mostrarClientes" />
                            <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn text="Email"><cellValueFactory><PropertyValueFactory property="email"/></cellValueFactory></TableColumn>
                                    <TableColumn text="Nombre"><cellValueFactory><PropertyValueFactory property="nombre"/></cellValueFactory></TableColumn>
                                    <TableColumn text="Domicilio"><cellValueFactory><PropertyValueFactory property="domicilio"/></cellValueFactory></TableColumn>
                                    <TableColumn text="NIF"><cellValueFactory><PropertyValueFactory property="nif"/></cellValueFactory></TableColumn>
                                    <TableColumn text="Tipo de clientes"><cellValueFactory><PropertyValueFactory property="tipo"/></cellValueFactory></TableColumn>
                                    <TableColumn text="Cuota anual"><cellValueFactory><PropertyValueFactory property="cuota"/></cellValueFactory></TableColumn>
                                    <TableColumn text="Descuento envíos"><cellValueFactory><PropertyValueFactory property="descuento"/></cellValueFactory></TableColumn>
                                </columns>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>
                
                <Tab text="Añadir Clientes">
                    <content>
                        <VBox spacing="15" alignment="CENTER_LEFT">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <Label text="Formulario alta cliente" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="120" halignment="RIGHT" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
        </columnConstraints>

        <children>
            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Domicilio:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txtDomicilio" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="NIF:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="txtNIF" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <ChoiceBox fx:id="cbTipoCliente" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label text="Cuota anual:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <TextField fx:id="txtcuotaAnual" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <Label text="Descuento envíos:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
            <TextField fx:id="txtdescuentoEnvios" GridPane.columnIndex="1" GridPane.rowIndex="6" />

        </children>
    </GridPane>

    <Button text="Guardar Cliente" onAction="#addCliente" />
</VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
        
        <Button text="Volver al Inicio" onAction="#volverInicio" />
    </children>
</VBox>