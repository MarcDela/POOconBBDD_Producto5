<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="650.0" prefWidth="850.0" spacing="15.0" 
      styleClass="root-container" 
      stylesheets="@estilos.css" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="InnerJoinConElCafe.controlador.PedidosController">
   <children>
      
      <HBox alignment="CENTER_RIGHT" prefHeight="50.0" spacing="10.0" styleClass="hbox-nav">
         <children>
            <Button onAction="#abrirMenuClientes" styleClass="boton-nav" text="CLIENTES" />
            <Button onAction="#abrirMenuArticulos" styleClass="boton-nav" text="ARTÍCULOS" />
            <Button onAction="#volverMenuPrincipal" styleClass="boton-rojo" text="VOLVER" />
         </children>
      </HBox>

      <Label text="GESTIÓN DE PEDIDOS" styleClass="titulo-principal" />

      <HBox alignment="CENTER" spacing="20.0">
         <children>
            <VBox spacing="5.0">
               <Label text="NIF Cliente:" styleClass="label-blanca" />
               <TextField fx:id="txtNifCliente" promptText="12345678X" />
            </VBox>
            <VBox spacing="5.0">
               <Label text="Código Artículo:" styleClass="label-blanca" />
               <TextField fx:id="txtCodigoArticulo" promptText="Ej: 101" />
            </VBox>
            <VBox spacing="5.0">
               <Label text="Cantidad:" styleClass="label-blanca" />
               <TextField fx:id="txtCantidad" prefWidth="80.0" promptText="Nº" />
            </VBox>
            <VBox spacing="5.0">
               <Label text="Nº Pedido (Eliminar):" styleClass="label-blanca" />
               <TextField fx:id="txtNumPedido" prefWidth="100.0" />
            </VBox>
         </children>
      </HBox>

      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button onAction="#anadirPedido" prefHeight="40.0" prefWidth="140.0" styleClass="boton-amarillo" text="AÑADIR PEDIDO" />
            <Button onAction="#mostrarPedidos" prefHeight="40.0" prefWidth="140.0" styleClass="boton-amarillo" text="MOSTRAR PEDIDOS" />
            <Button onAction="#eliminarPedido" prefHeight="40.0" prefWidth="140.0" styleClass="boton-amarillo" text="ELIMINAR PEDIDO" />
         </children>
         <padding>
            <Insets top="10.0" />
         </padding>
      </HBox>

      <Label text="Filtrar muestra de pedidos" styleClass="subtitulo" />

      <HBox alignment="CENTER" prefHeight="24.0" spacing="15.0">
         <children>
            <RadioButton fx:id="rbTodos" selected="true" text="Todos">
               <toggleGroup>
                  <ToggleGroup fx:id="grupoEstado" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="rbEnCurso" text="Solo en curso" toggleGroup="$grupoEstado" />
            <RadioButton fx:id="rbProcesados" text="Solo Procesados" toggleGroup="$grupoEstado" />
         </children>
      </HBox>

      <VBox prefHeight="300.0" spacing="5.0" styleClass="vbox-consola">
         <children>
            <Label text="CONSOLA DE SALIDA / RESULTADOS:" styleClass="label-cyan-bold" />
            <TextArea fx:id="txtAreaResultados" editable="false" prefHeight="250.0" styleClass="consola" />
         </children>
      </VBox>
   </children>
</VBox>
